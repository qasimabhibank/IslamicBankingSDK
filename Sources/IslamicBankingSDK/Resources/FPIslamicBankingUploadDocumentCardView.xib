<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="ud-root" customClass="FPIslamicBankingUploadDocumentCardView" customModule="IslamicBankingSDK" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="361" height="164"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
            <subviews>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="ud-card">
                    <rect key="frame" x="0.0" y="0.0" width="361" height="164"/>
                    <subviews>
                        <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="inProgress" translatesAutoresizingMaskIntoConstraints="NO" id="ud-icon">
                            <rect key="frame" x="20" y="20" width="50" height="50"/>
                            <constraints>
                                <constraint firstAttribute="width" constant="50" id="ud-icon-w"/>
                                <constraint firstAttribute="height" constant="50" id="ud-icon-h"/>
                            </constraints>
                        </imageView>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="1. Declaration" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ud-title">
                            <rect key="frame" x="82" y="20" width="100" height="17"/>
                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="14"/>
                            <color key="textColor" red="0.16078431369999999" green="0.1647058824" blue="0.1764705882" alpha="1" colorSpace="calibratedRGB"/>
                            <nil key="highlightedColor"/>
                        </label>
                        <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="ud-pill">
                            <rect key="frame" x="82" y="45" width="143" height="25"/>
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Signed purchase declaration" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ud-subtitle">
                                    <rect key="frame" x="0.0" y="4" width="143" height="17"/>
                                    <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="10"/>
                                    <color key="textColor" red="0.44705882349999998" green="0.44705882349999998" blue="0.44705882349999998" alpha="1" colorSpace="calibratedRGB"/>
                                    <nil key="highlightedColor"/>
                                </label>
                            </subviews>
                            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            <constraints>
                                <constraint firstItem="ud-subtitle" firstAttribute="top" secondItem="ud-pill" secondAttribute="top" constant="4" id="ud-pill-t"/>
                                <constraint firstItem="ud-subtitle" firstAttribute="leading" secondItem="ud-pill" secondAttribute="leading" id="ud-pill-l"/>
                                <constraint firstAttribute="trailing" secondItem="ud-subtitle" secondAttribute="trailing" id="ud-pill-r"/>
                                <constraint firstAttribute="bottom" secondItem="ud-subtitle" secondAttribute="bottom" constant="4" id="ud-pill-b"/>
                            </constraints>
                        </view>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="ud-btn">
                            <rect key="frame" x="20" y="94" width="321" height="50"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="50" id="ud-btn-h"/>
                            </constraints>
                            <color key="tintColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            <state key="normal" title="Button"/>
                            <buttonConfiguration key="configuration" style="plain" title="Sign Declaration">
                                <backgroundConfiguration key="background" image="GradientButton"/>
                                <fontDescription key="titleFontDescription" name="HelveticaNeue-Bold" family="Helvetica Neue" pointSize="17"/>
                            </buttonConfiguration>
                            <connections>
                                <action selector="actionButtonTapped:" destination="ud-root" eventType="touchUpInside" id="ud-btn-act"/>
                            </connections>
                        </button>
                    </subviews>
                    <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    <constraints>
                        <constraint firstItem="ud-icon" firstAttribute="leading" secondItem="ud-card" secondAttribute="leading" constant="20" id="ud-c1"/>
                        <constraint firstItem="ud-icon" firstAttribute="top" secondItem="ud-card" secondAttribute="top" constant="20" id="ud-c2"/>
                        <constraint firstItem="ud-title" firstAttribute="leading" secondItem="ud-icon" secondAttribute="trailing" constant="12" id="ud-c3"/>
                        <constraint firstItem="ud-title" firstAttribute="top" secondItem="ud-card" secondAttribute="top" constant="20" id="ud-c4"/>
                        <constraint firstItem="ud-pill" firstAttribute="leading" secondItem="ud-icon" secondAttribute="trailing" constant="12" id="ud-c5"/>
                        <constraint firstItem="ud-pill" firstAttribute="top" secondItem="ud-title" secondAttribute="bottom" constant="8" id="ud-c6"/>
                        <constraint firstItem="ud-btn" firstAttribute="top" secondItem="ud-icon" secondAttribute="bottom" constant="24" id="ud-c7"/>
                        <constraint firstItem="ud-btn" firstAttribute="leading" secondItem="ud-card" secondAttribute="leading" constant="20" id="ud-c8"/>
                        <constraint firstAttribute="trailing" secondItem="ud-btn" secondAttribute="trailing" constant="20" id="ud-c9"/>
                        <constraint firstAttribute="bottom" secondItem="ud-btn" secondAttribute="bottom" constant="20" id="ud-c10"/>
                    </constraints>
                </view>
            </subviews>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="ud-card" firstAttribute="top" secondItem="ud-root" secondAttribute="top" id="ud-r1"/>
                <constraint firstItem="ud-card" firstAttribute="leading" secondItem="ud-root" secondAttribute="leading" id="ud-r2"/>
                <constraint firstAttribute="trailing" secondItem="ud-card" secondAttribute="trailing" id="ud-r3"/>
                <constraint firstAttribute="bottom" secondItem="ud-card" secondAttribute="bottom" id="ud-r4"/>
            </constraints>
            <connections>
                <outlet property="actionButton" destination="ud-btn" id="ud-o-btn"/>
                <outlet property="cardContainerView" destination="ud-card" id="ud-o-card"/>
                <outlet property="statusImageView" destination="ud-icon" id="ud-o-icon"/>
                <outlet property="subtitleLabel" destination="ud-subtitle" id="ud-o-sub"/>
                <outlet property="subtitlePillView" destination="ud-pill" id="ud-o-pill"/>
                <outlet property="titleLabel" destination="ud-title" id="ud-o-title"/>
            </connections>
            <point key="canvasLocation" x="139" y="21"/>
